    <!-- ─── JS ─── -->
    <script>
      // ── Nav scroll effect ──
      const nav = document.getElementById('main-nav');
      window.addEventListener('scroll', () => {
        nav.classList.toggle('scrolled', window.scrollY > 40);
      }, { passive: true });

      // ── Hero Slideshow ──
      const slides = document.querySelectorAll('.hero-slide');
      const dots = document.querySelectorAll('.hero-dot');
      let current = 0;
      let timer;

      function goTo(index) {
        slides[current].classList.remove('active');
        dots[current].classList.remove('active');
        current = index;
        slides[current].classList.add('active');
        dots[current].classList.add('active');
      }

      function next() {
        goTo((current + 1) % slides.length);
      }

      function startTimer() {
        timer = setInterval(next, 5000);
      }

      dots.forEach(dot => {
        dot.addEventListener('click', () => {
          clearInterval(timer);
          goTo(parseInt(dot.dataset.index));
          startTimer();
        });
      });

      startTimer();

      // ── Hero catch — character stagger ──
      const catchEl = document.getElementById('hero-catch');
      const text = catchEl.textContent;
      catchEl.innerHTML = '';
      [...text].forEach((ch, i) => {
        const span = document.createElement('span');
        span.className = 'char';
        span.textContent = ch === ' ' ? ' ' : ch;
        span.style.animationDelay = (0.08 * i) + 's';
        catchEl.appendChild(span);
      });

      // ── Menu Carousel (infinite auto-scroll) ──
      const track = document.getElementById('menuTrack');
      if (track) {
        const cards = Array.from(track.children);
        // クローンを末尾に追加してシームレスループを実現
        cards.forEach(card => {
          track.appendChild(card.cloneNode(true));
        });

        const cardWidth = 260 + 24; // flex-basis + gap
        const totalCards = cards.length; // 元の6枚
        let position = 0;
        let rafId;

        function autoScroll() {
          position += 0.5;
          if (position >= cardWidth * totalCards) {
            position = 0;
          }
          track.style.transform = 'translateX(-' + position + 'px)';
          rafId = requestAnimationFrame(autoScroll);
        }

        autoScroll();

        // ホバー中は一時停止
        track.addEventListener('mouseenter', () => cancelAnimationFrame(rafId));
        track.addEventListener('mouseleave', () => { rafId = requestAnimationFrame(autoScroll); });
      }

      // ── Scroll Reveal (IntersectionObserver) ──
      const revealEls = document.querySelectorAll('.reveal');
      const observer = new IntersectionObserver((entries) => {
        entries.forEach(entry => {
          if (entry.isIntersecting) {
            entry.target.classList.add('visible');
            observer.unobserve(entry.target);
          }
        });
      }, { threshold: 0.12, rootMargin: '0px 0px -40px 0px' });

      revealEls.forEach(el => observer.observe(el));
    </script>


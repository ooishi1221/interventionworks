---
const title = "IT サポート — Intervention Works";
const description = "足立区・北区の個人店オーナー向け IT サポート。予約の自動化から Instagram の仕組みづくり、ホームページ制作まで。まず LINE かメールでご相談ください。";

const pains = [
  {
    icon: `<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07A19.5 19.5 0 0 1 4.69 12 19.79 19.79 0 0 1 1.61 3.4 2 2 0 0 1 3.58 1h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L7.91 8.55a16 16 0 0 0 6 6l.92-.92a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 21.73 16v.92z"/></svg>`,
    text: "予約の電話が多くて、お客さんへの対応に集中できない",
  },
  {
    icon: `<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect width="20" height="20" x="2" y="2" rx="5" ry="5"/><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/><line x1="17.5" x2="17.51" y1="6.5" y2="6.5"/></svg>`,
    text: "SNS を更新しないといけないとわかってるけど、時間が取れない",
  },
  {
    icon: `<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/><path d="M12 2a14.5 14.5 0 0 0 0 20 14.5 14.5 0 0 0 0-20"/><path d="M2 12h20"/></svg>`,
    text: "ホームページを作りたいけど、何から始めればいいかわからない",
  },
  {
    icon: `<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="22 7 13.5 15.5 8.5 10.5 2 17"/><polyline points="16 7 22 7 22 13"/></svg>`,
    text: "予約サイトやポータルの手数料が高くて、利益が残らない",
  },
];

const services = [
  {
    num: "01",
    icon: `<svg xmlns="http://www.w3.org/2000/svg" width="64" height="64" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.25" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>`,
    name: "LINE 予約の自動化",
    desc: "電話に出られない時間でも、LINE で予約を受け付けられる仕組みをつくります。営業時間外でも自動で対応。",
  },
  {
    num: "02",
    icon: `<svg xmlns="http://www.w3.org/2000/svg" width="64" height="64" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.25" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect width="20" height="20" x="2" y="2" rx="5" ry="5"/><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/><line x1="17.5" x2="17.51" y1="6.5" y2="6.5"/></svg>`,
    name: "Instagram DM 自動返信",
    desc: "「営業時間は何時ですか？」といったよくある質問に、Instagram の DM が自動で答えてくれる仕組みです。",
  },
  {
    num: "03",
    icon: `<svg xmlns="http://www.w3.org/2000/svg" width="64" height="64" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.25" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect width="20" height="14" x="2" y="5" rx="2"/><line x1="2" x2="22" y1="10" y2="10"/></svg>`,
    name: "予約・お支払いページ",
    desc: "お店専用の予約ページをつくります。来店前に決済も完了できるので、当日の会計がスムーズになります。",
  },
  {
    num: "04",
    icon: `<svg xmlns="http://www.w3.org/2000/svg" width="64" height="64" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.25" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect width="20" height="14" x="2" y="3" rx="2"/><path d="M8 21h8m-4-4v4"/></svg>`,
    name: "ホームページ制作",
    desc: "お店の雰囲気や想いが伝わるホームページをつくります。スマホで見やすいデザインで、Google からも来てもらいやすくなります。",
  },
];

const faqs = [
  {
    q: "費用はどのくらいかかりますか？",
    a: "サービス内容によって異なります。まずは無料でご相談いただき、内容を確認してからお見積もりします。相談だけで費用が発生することはありません。",
  },
  {
    q: "IT の知識がなくても大丈夫ですか？",
    a: "はい、問題ありません。難しい用語は使わず、何をどうするかを分かりやすく説明します。完成後の操作方法もご説明します。",
  },
  {
    q: "どのくらいの期間で完成しますか？",
    a: "内容によって異なりますが、LINE 予約の自動化であれば 1〜2 週間、ホームページであれば 2〜4 週間が目安です。",
  },
];
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:site_name" content="Intervention Works" />
    <meta property="og:locale" content="ja_JP" />

    <meta name="twitter:card" content="summary" />
    <meta name="twitter:site" content="@intervention_jp" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Noto+Sans+JP:wght@400;700&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>

    <!-- ナビ -->
    <nav class="top-nav" aria-label="サイトナビゲーション">
      <a href="/" class="nav-logo" aria-label="Intervention Works トップへ">
        <svg class="logo-mark" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 128 128" aria-hidden="true">
          <path d="M50.4 78.5a75.1 75.1 0 0 0-28.5 6.9l24.2-65.7c.7-2 1.9-3.2 3.4-3.2h29c1.5 0 2.7 1.2 3.4 3.2l24.2 65.7s-11.6-7-28.5-7L67 45.5c-.4-1.7-1.6-2.8-2.9-2.8-1.3 0-2.5 1.1-2.9 2.7L50.4 78.5Zm-1.1 28.2Zm-4.2-20.2c-2 6.6-.6 15.8 4.2 20.2a17.5 17.5 0 0 1 .2-.7 5.5 5.5 0 0 1 5.7-4.5c2.8.1 4.3 1.5 4.7 4.7.2 1.1.2 2.3.2 3.5v.4c0 2.7.7 5.2 2.2 7.4a13 13 0 0 0 5.7 4.9v-.3l-.2-.3c-1.8-5.6-.5-9.5 4.4-12.8l1.5-1a73 73 0 0 0 3.2-2.2 16 16 0 0 0 6.8-11.4c.3-2 .1-4-.6-6l-.8.6-1.6 1a37 37 0 0 1-22.4 2.7c-5-.7-9.7-2-13.2-6.2Z" />
        </svg>
        <span class="nav-brand">Intervention Works</span>
      </a>
    </nav>

    <main>

      <!-- ヒーロー -->
      <section class="hero">
        <div class="hero-inner">
          <p class="hero-tag">足立区・北区の個人店オーナーへ</p>
          <h1 class="hero-heading">
            「電話対応・SNS・HP——<br />
            その「やらなきゃ」から、<br />
            解放します。」
          </h1>
          <p class="hero-sub">
            仕組みで解決できることは、仕組みに任せましょう。
          </p>
          <div class="hero-badges" aria-label="対応サービス一覧">
            <span class="hero-badge">LINE予約対応</span>
            <span class="hero-badge">SNS自動化</span>
            <span class="hero-badge">HP制作</span>
            <span class="hero-badge">決済導入</span>
          </div>
          <a href="https://lin.ee/PwGYxqQ" class="hero-cta" target="_blank" rel="noopener noreferrer">
            <svg class="hero-cta-icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" aria-hidden="true">
              <path d="M19.365 9.863c.349 0 .63.285.63.631 0 .345-.281.63-.63.63H17.61v1.125h1.755c.349 0 .63.283.63.63 0 .344-.281.629-.63.629h-2.386c-.345 0-.627-.285-.627-.629V8.108c0-.345.282-.63.627-.63h2.386c.349 0 .63.285.63.63 0 .349-.281.63-.63.63H17.61v1.125h1.755zm-3.855 3.016c0 .27-.174.51-.432.596-.064.021-.133.031-.199.031-.211 0-.391-.09-.51-.25l-2.443-3.317v2.94c0 .344-.279.629-.631.629-.346 0-.626-.285-.626-.629V8.108c0-.27.173-.51.43-.595.06-.023.136-.033.194-.033.195 0 .375.104.495.254l2.462 3.33V8.108c0-.345.282-.63.63-.63.345 0 .63.285.63.63v4.771zm-5.741 0c0 .344-.282.629-.631.629-.345 0-.627-.285-.627-.629V8.108c0-.345.282-.63.627-.63.349 0 .631.285.631.63v4.771zm-2.466.629H4.917c-.345 0-.63-.285-.63-.629V8.108c0-.345.285-.63.63-.63.348 0 .63.285.63.63v4.141h1.756c.348 0 .629.283.629.63 0 .344-.281.629-.629.629M24 10.314C24 4.943 18.615.572 12 .572S0 4.943 0 10.314c0 4.811 4.27 8.842 10.035 9.608.391.082.923.258 1.058.59.12.301.079.766.038 1.08l-.164 1.02c-.045.301-.24 1.186 1.049.645 1.291-.539 6.916-4.078 9.436-6.975C23.176 14.393 24 12.458 24 10.314"/>
            </svg>
            まず LINE で相談する
          </a>
        </div>
      </section>

      <!-- こんなお悩みはありませんか？ -->
      <section class="pains reveal-section">
        <div class="section-inner">
          <h2 class="section-heading">
            <span class="section-label">こんなお悩みはありませんか？</span>
          </h2>
          <ul class="pain-grid">
            {pains.map((p) => (
              <li class="pain-item">
                <div class="pain-icon-wrap" aria-hidden="true">
                  <span class="pain-icon" set:html={p.icon} />
                </div>
                <p class="pain-text">{p.text}</p>
              </li>
            ))}
          </ul>
        </div>
      </section>

      <!-- ソリューションブリッジ -->
      <section class="bridge" aria-label="解決できます">
        <div class="bridge-inner">
          <p class="bridge-heading">そのお悩み、全部<br />仕組みで解決できます。</p>
          <p class="bridge-sub">IT の知識は不要です。やることだけ決めれば、あとはお任せください。</p>
        </div>
      </section>

      <!-- 実際に作ったもの -->
      <section class="works reveal-section">
        <div class="section-inner">
          <h2 class="section-heading">
            <span class="section-label">実際に作ったもの</span>
          </h2>
          <div class="works-list">
            <div class="works-card">
              <div class="works-card-icon" aria-hidden="true">
                <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M9 11l3 3L22 4"/><path d="M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11"/></svg>
              </div>
              <h3 class="works-title">吉野家グループ向け<br />業務チェックリストツール</h3>
              <p class="works-desc">チェックリストを Web 上で作成し Excel/PDF に出力。事務担当者の毎月の業務を仕組み化。</p>
              <a href="https://yoshinoya-two.vercel.app" class="works-link" target="_blank" rel="noopener noreferrer">見てみる →</a>
            </div>
            <div class="works-card">
              <div class="works-card-icon" aria-hidden="true">
                <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
              </div>
              <h3 class="works-title">個人店向け<br />顧客管理アプリ（GnH）</h3>
              <p class="works-desc">来店客の情報をスマホで管理し、次回のアクション提案まで行う Web アプリ。</p>
              <a href="https://gnh-pink.vercel.app" class="works-link" target="_blank" rel="noopener noreferrer">見てみる →</a>
            </div>
          </div>
        </div>
      </section>

      <!-- できること -->
      <section class="services reveal-section">
        <div class="section-inner">
          <h2 class="section-heading">
            <span class="section-label">できること</span>
          </h2>
          <ul class="service-list">
            {services.map((s, i) => (
              <li class={`service-item ${i % 2 === 1 ? "service-item--reverse" : ""}`}>
                <div class="service-icon-wrap">
                  <span class="service-icon" set:html={s.icon} />
                </div>
                <div class="service-body">
                  <span class="service-num" aria-hidden="true">{s.num}</span>
                  <h3 class="service-name">{s.name}</h3>
                  <p class="service-desc">{s.desc}</p>
                </div>
              </li>
            ))}
          </ul>
        </div>
      </section>

      <!-- こんな流れで進みます -->
      <section class="flow reveal-section">
        <div class="section-inner">
          <h2 class="section-heading">
            <span class="section-label">こんな流れで進みます</span>
          </h2>
          <ol class="flow-list">
            <li class="flow-item">
              <span class="flow-num" aria-hidden="true">01</span>
              <div class="flow-body">
                <h3 class="flow-title">まず話を聞かせてください</h3>
                <p class="flow-desc">LINE かメールで状況を教えてください。費用や内容より先に、困ってることを聞きます。</p>
              </div>
            </li>
            <li class="flow-item">
              <span class="flow-num" aria-hidden="true">02</span>
              <div class="flow-body">
                <h3 class="flow-title">現状を一緒に整理します</h3>
                <p class="flow-desc">お店の状況をヒアリングして、何が本当に必要かを一緒に考えます。</p>
              </div>
            </li>
            <li class="flow-item">
              <span class="flow-num" aria-hidden="true">03</span>
              <div class="flow-body">
                <h3 class="flow-title">やること・費用をお伝えします</h3>
                <p class="flow-desc">何をどう進めるか、いくらかかるかを明確にお伝えします。納得してからスタート。</p>
              </div>
            </li>
            <li class="flow-item">
              <span class="flow-num" aria-hidden="true">04</span>
              <div class="flow-body">
                <h3 class="flow-title">着手・完成・フォロー</h3>
                <p class="flow-desc">完成後も使い方がわからない時はいつでも聞いてください。</p>
              </div>
            </li>
          </ol>
        </div>
      </section>

      <!-- FAQ -->
      <section class="faq reveal-section">
        <div class="section-inner">
          <h2 class="section-heading">
            <span class="section-label">よくある質問</span>
          </h2>
          <dl class="faq-list">
            {faqs.map((item, i) => (
              <div class="faq-item" data-faq-index={i}>
                <dt class="faq-q">
                  <button
                    class="faq-btn"
                    aria-expanded="false"
                    aria-controls={`faq-answer-${i}`}
                    type="button"
                  >
                    <span class="faq-q-label">Q.</span>
                    <span class="faq-q-text">{item.q}</span>
                    <span class="faq-chevron" aria-hidden="true">
                      <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"/></svg>
                    </span>
                  </button>
                </dt>
                <dd class="faq-a" id={`faq-answer-${i}`} hidden>
                  <div class="faq-a-inner">
                    <span class="faq-a-label">A.</span>
                    <p class="faq-a-text">{item.a}</p>
                  </div>
                </dd>
              </div>
            ))}
          </dl>
        </div>
      </section>

      <!-- CTA -->
      <section id="contact" class="cta reveal-section">
        <div class="section-inner cta-inner">
          <h2 class="cta-heading">まず15分だけ、話してみませんか</h2>
          <p class="cta-sub">
            費用・契約・売り込みは一切なし。お店の状況を聞かせてもらうだけでかまいません。
          </p>
          <div class="cta-buttons">
            <a
              href="https://lin.ee/PwGYxqQ"
              class="btn btn-line"
              target="_blank"
              rel="noopener noreferrer"
            >
              <svg class="btn-icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" aria-hidden="true">
                <path d="M19.365 9.863c.349 0 .63.285.63.631 0 .345-.281.63-.63.63H17.61v1.125h1.755c.349 0 .63.283.63.63 0 .344-.281.629-.63.629h-2.386c-.345 0-.627-.285-.627-.629V8.108c0-.345.282-.63.627-.63h2.386c.349 0 .63.285.63.63 0 .349-.281.63-.63.63H17.61v1.125h1.755zm-3.855 3.016c0 .27-.174.51-.432.596-.064.021-.133.031-.199.031-.211 0-.391-.09-.51-.25l-2.443-3.317v2.94c0 .344-.279.629-.631.629-.346 0-.626-.285-.626-.629V8.108c0-.27.173-.51.43-.595.06-.023.136-.033.194-.033.195 0 .375.104.495.254l2.462 3.33V8.108c0-.345.282-.63.63-.63.345 0 .63.285.63.63v4.771zm-5.741 0c0 .344-.282.629-.631.629-.345 0-.627-.285-.627-.629V8.108c0-.345.282-.63.627-.63.349 0 .631.285.631.63v4.771zm-2.466.629H4.917c-.345 0-.63-.285-.63-.629V8.108c0-.345.285-.63.63-.63.348 0 .63.285.63.63v4.141h1.756c.348 0 .629.283.629.63 0 .344-.281.629-.629.629M24 10.314C24 4.943 18.615.572 12 .572S0 4.943 0 10.314c0 4.811 4.27 8.842 10.035 9.608.391.082.923.258 1.058.59.12.301.079.766.038 1.08l-.164 1.02c-.045.301-.24 1.186 1.049.645 1.291-.539 6.916-4.078 9.436-6.975C23.176 14.393 24 12.458 24 10.314"/>
              </svg>
              LINE で相談する
            </a>
            <a
              href="mailto:info@intervention.jp"
              class="btn btn-mail"
            >
              <svg class="btn-icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <rect width="20" height="16" x="2" y="4" rx="2"/>
                <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/>
              </svg>
              メールで相談する
            </a>
          </div>
          <p class="cta-note">info@intervention.jp</p>
        </div>
      </section>

    </main>

    <!-- フッター -->
    <footer class="footer">
      <div class="footer-inner">
        <a href="/" class="footer-logo" aria-label="Intervention Works トップへ">
          <svg class="footer-logo-mark" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 128 128" aria-hidden="true">
            <path d="M50.4 78.5a75.1 75.1 0 0 0-28.5 6.9l24.2-65.7c.7-2 1.9-3.2 3.4-3.2h29c1.5 0 2.7 1.2 3.4 3.2l24.2 65.7s-11.6-7-28.5-7L67 45.5c-.4-1.7-1.6-2.8-2.9-2.8-1.3 0-2.5 1.1-2.9 2.7L50.4 78.5Zm-1.1 28.2Zm-4.2-20.2c-2 6.6-.6 15.8 4.2 20.2a17.5 17.5 0 0 1 .2-.7 5.5 5.5 0 0 1 5.7-4.5c2.8.1 4.3 1.5 4.7 4.7.2 1.1.2 2.3.2 3.5v.4c0 2.7.7 5.2 2.2 7.4a13 13 0 0 0 5.7 4.9v-.3l-.2-.3c-1.8-5.6-.5-9.5 4.4-12.8l1.5-1a73 73 0 0 0 3.2-2.2 16 16 0 0 0 6.8-11.4c.3-2 .1-4-.6-6l-.8.6-1.6 1a37 37 0 0 1-22.4 2.7c-5-.7-9.7-2-13.2-6.2Z" />
          </svg>
          <span>Intervention Works</span>
        </a>
        <p class="footer-copy">&copy; 2026 Intervention Works</p>
      </div>
    </footer>

    <script>
      // Scroll reveal
      const revealSections = document.querySelectorAll(".reveal-section");
      const obs = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              entry.target.classList.add("revealed");
              obs.unobserve(entry.target);
            }
          });
        },
        { threshold: 0.1 }
      );
      revealSections.forEach((el) => obs.observe(el));

      // FAQ accordion
      document.querySelectorAll(".faq-btn").forEach((btn) => {
        btn.addEventListener("click", () => {
          const expanded = btn.getAttribute("aria-expanded") === "true";
          const answerId = btn.getAttribute("aria-controls");
          const answer = document.getElementById(answerId!);
          const item = btn.closest(".faq-item");

          btn.setAttribute("aria-expanded", String(!expanded));
          if (answer) {
            if (expanded) {
              answer.hidden = true;
            } else {
              answer.hidden = false;
            }
          }
          item?.classList.toggle("faq-open", !expanded);
        });
      });
    </script>
  </body>
</html>


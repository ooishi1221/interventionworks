---
const title = "IT サポート — Intervention Works";
const description = "足立区・北区の個人店オーナー向け IT サポート。予約の自動化から Instagram の仕組みづくり、ホームページ制作まで。まず LINE かメールでご相談ください。";

const pains = [
  {
    img: "/images/service/illust-phone.png",
    text: "「予約電話が鳴るたびに。目の前のお客さんから手が離れる」",
  },
  {
    img: "/images/service/illust-sns2.png",
    text: "「投稿しなきゃと思いながら。今日も閉店時間になってしまった」",
  },
  {
    img: "/images/service/illust-hp.png",
    text: "「HPは3年前に作ったきり。誰かに見られてるのかすら分からない」",
  },
  {
    img: "/images/service/illust-fee.png",
    text: "「ポータルに払うたびに。何か違うと感じている」",
  },
];

const services = [
  {
    num: "01",
    icon: `<svg xmlns="http://www.w3.org/2000/svg" width="64" height="64" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.25" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 22V12m0 0V2m0 10H2m10 0h10"/></svg>`,
    name: "繰り返しの作業を仕組みに渡す",
    desc: "予約・DM・更新——手が離れていい仕事は全部自動にします。目の前のお客さんに。もっと集中できるようになります。",
  },
  {
    num: "02",
    icon: `<svg xmlns="http://www.w3.org/2000/svg" width="64" height="64" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.25" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/><path d="M12 8v4l3 3"/></svg>`,
    name: "「何をすべきか」を一緒に考える",
    desc: "時間が空いても向かう方向が間違えれば意味がない。仕組みを作りながらどう使うかも一緒に設計します。",
  },
  {
    num: "03",
    icon: `<svg xmlns="http://www.w3.org/2000/svg" width="64" height="64" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.25" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="23 6 13.5 15.5 8.5 10.5 1 18"/><polyline points="17 6 23 6 23 12"/></svg>`,
    name: "毎月アップデートし続ける",
    desc: "作って終わりにしません。時代もお客さんも毎月変わるから。ずっと一緒に走ります。",
  },
];

const faqs = [
  {
    q: "費用はどのくらいかかりますか？",
    a: "内容によって異なります。まずは無料でご相談いただきます。何が必要かを確認してからお見積もりします。相談だけで費用が発生することはありません。",
  },
  {
    q: "ITの知識がなくても大丈夫ですか？",
    a: "はい、問題ありません。難しい用語は使いません。「こうなりたい」だけ教えてもらえれば。あとはこちらで設計します。",
  },
  {
    q: "作ってもらったら。あとは自分で管理しないといけませんか？",
    a: "月額での継続サポートも承っています。「作って終わり」ではなく。毎月一緒に見直す伴走型のプランもご相談ください。",
  },
];
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:site_name" content="Intervention Works" />
    <meta property="og:locale" content="ja_JP" />

    <meta name="twitter:card" content="summary" />
    <meta name="twitter:site" content="@intervention_jp" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Noto+Sans+JP:wght@400;700&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>

    <!-- ナビ -->
    <nav class="top-nav" aria-label="サイトナビゲーション">
      <a href="/" class="nav-logo" aria-label="Intervention Works トップへ">
        <svg class="logo-mark" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 128 128" aria-hidden="true">
          <path d="M50.4 78.5a75.1 75.1 0 0 0-28.5 6.9l24.2-65.7c.7-2 1.9-3.2 3.4-3.2h29c1.5 0 2.7 1.2 3.4 3.2l24.2 65.7s-11.6-7-28.5-7L67 45.5c-.4-1.7-1.6-2.8-2.9-2.8-1.3 0-2.5 1.1-2.9 2.7L50.4 78.5Zm-1.1 28.2Zm-4.2-20.2c-2 6.6-.6 15.8 4.2 20.2a17.5 17.5 0 0 1 .2-.7 5.5 5.5 0 0 1 5.7-4.5c2.8.1 4.3 1.5 4.7 4.7.2 1.1.2 2.3.2 3.5v.4c0 2.7.7 5.2 2.2 7.4a13 13 0 0 0 5.7 4.9v-.3l-.2-.3c-1.8-5.6-.5-9.5 4.4-12.8l1.5-1a73 73 0 0 0 3.2-2.2 16 16 0 0 0 6.8-11.4c.3-2 .1-4-.6-6l-.8.6-1.6 1a37 37 0 0 1-22.4 2.7c-5-.7-9.7-2-13.2-6.2Z" />
        </svg>
        <span class="nav-brand">Intervention Works</span>
      </a>
    </nav>

    <main>

      <!-- ヒーロー -->
      <section class="hero">
        <div class="hero-inner">
          <div class="hero-text">
            <h1 class="hero-heading">
              時間を作る。<br />
              売れる設計にする。<br />
              変化に合わせる。
            </h1>
            <p class="hero-sub">
              「いい仕事をしているのに。雑務で1日が終わる」<br />
              「SNSもHPも。やらなきゃと思いながら何年も経った」<br /><br />
              仕組みを作れば時間は空く。<br />
              でも時間が空くだけでは売上は動かない。<br />
              だから一緒に考える。そして毎月更新し続ける。
            </p>
            <div class="hero-badges" aria-label="対応サービス一覧">
              <div class="hero-badges-inner">
                <span class="hero-badge">仕組み化</span>
                <span class="hero-badge">売れる設計</span>
                <span class="hero-badge">伴走型</span>
                <span class="hero-badge">月額対応</span>
              </div>
              <span class="hero-tag-inline">足立区・北区の個人店オーナーへ</span>
            </div>
            <a href="https://lin.ee/PwGYxqQ" class="hero-cta" target="_blank" rel="noopener noreferrer">
              <svg class="hero-cta-icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" aria-hidden="true">
                <path d="M19.365 9.863c.349 0 .63.285.63.631 0 .345-.281.63-.63.63H17.61v1.125h1.755c.349 0 .63.283.63.63 0 .344-.281.629-.63.629h-2.386c-.345 0-.627-.285-.627-.629V8.108c0-.345.282-.63.627-.63h2.386c.349 0 .63.285.63.63 0 .349-.281.63-.63.63H17.61v1.125h1.755zm-3.855 3.016c0 .27-.174.51-.432.596-.064.021-.133.031-.199.031-.211 0-.391-.09-.51-.25l-2.443-3.317v2.94c0 .344-.279.629-.631.629-.346 0-.626-.285-.626-.629V8.108c0-.27.173-.51.43-.595.06-.023.136-.033.194-.033.195 0 .375.104.495.254l2.462 3.33V8.108c0-.345.282-.63.63-.63.345 0 .63.285.63.63v4.771zm-5.741 0c0 .344-.282.629-.631.629-.345 0-.627-.285-.627-.629V8.108c0-.345.282-.63.627-.63.349 0 .631.285.631.63v4.771zm-2.466.629H4.917c-.345 0-.63-.285-.63-.629V8.108c0-.345.285-.63.63-.63.348 0 .63.285.63.63v4.141h1.756c.348 0 .629.283.629.63 0 .344-.281.629-.629.629M24 10.314C24 4.943 18.615.572 12 .572S0 4.943 0 10.314c0 4.811 4.27 8.842 10.035 9.608.391.082.923.258 1.058.59.12.301.079.766.038 1.08l-.164 1.02c-.045.301-.24 1.186 1.049.645 1.291-.539 6.916-4.078 9.436-6.975C23.176 14.393 24 12.458 24 10.314"/>
              </svg>
              まず手放したい作業を相談する
            </a>
          </div>
          <div class="hero-illust" aria-hidden="true">
            <img
              src="/images/service/illust-owner.png"
              alt=""
              class="hero-illust-img"
              width="400"
              loading="eager"
              decoding="async"
            />
          </div>
        </div>
      </section>

      <!-- こんなお悩みはありませんか？ -->
      <section class="pains reveal-section">
        <div class="section-inner">
          <h2 class="section-heading">
            <span class="section-label">こんな本音、ありませんか？</span>
          </h2>
          <ul class="pain-grid">
            {pains.map((p) => (
              <li class="pain-item">
                <img
                  src={p.img}
                  alt=""
                  class="pain-illust"
                  loading="lazy"
                  decoding="async"
                  aria-hidden="true"
                />
                <p class="pain-text">{p.text}</p>
              </li>
            ))}
          </ul>
        </div>
      </section>

      <!-- ソリューションブリッジ -->
      <section class="bridge" aria-label="解決できます">
        <div class="bridge-inner">
          <p class="bridge-heading">それは全部。仕組みと設計と<br />続けてくれる人がいれば変わります。</p>
        </div>
      </section>

      <!-- 実際に作ったもの -->
      <section class="works reveal-section">
        <div class="section-inner">
          <h2 class="section-heading">
            <span class="section-label">実際に作ったもの</span>
          </h2>
          <div class="works-carousel-wrap">
            <div class="works-track" id="worksTrack">
            <div class="works-card">
              <div class="works-card-icon" aria-hidden="true">
                <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M9 11l3 3L22 4"/><path d="M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11"/></svg>
              </div>
              <h3 class="works-title">業務効率化<br />チェックリストツール</h3>
              <p class="works-desc">事務担当者の毎月の業務を仕組み化したツール。Web 上でチェックリストを作成し Excel/PDF に出力。</p>
              <a href="https://yoshinoya-two.vercel.app" class="works-link" target="_blank" rel="noopener noreferrer">見てみる →</a>
            </div>
            <div class="works-card">
              <div class="works-card-icon" aria-hidden="true">
                <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
              </div>
              <h3 class="works-title">個人店向け<br />顧客管理アプリ（GnH）</h3>
              <p class="works-desc">来店客の情報をスマホで管理し、次回のアクション提案まで行う Web アプリ。</p>
              <a href="https://gnh-pink.vercel.app" class="works-link" target="_blank" rel="noopener noreferrer">見てみる →</a>
            </div>
            <div class="works-card">
              <div class="works-card-icon" aria-hidden="true">
                <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
              </div>
              <h3 class="works-title">サービス稼働監視<br />ダッシュボード</h3>
              <p class="works-desc">複数の Web サービスをリアルタイムで監視するダッシュボード。異常検知・通知まで自動化したインフラ管理ツール。</p>
              <a href="https://status.intervention.jp/" class="works-link" target="_blank" rel="noopener noreferrer">見てみる →</a>
            </div>
            <div class="works-card">
              <div class="works-card-icon" aria-hidden="true">
                <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M18 8h1a4 4 0 0 1 0 8h-1"/><path d="M2 8h16v9a4 4 0 0 1-4 4H6a4 4 0 0 1-4-4V8z"/><line x1="6" x2="6" y1="1" y2="4"/><line x1="10" x2="10" y1="1" y2="4"/><line x1="14" x2="14" y1="1" y2="4"/></svg>
              </div>
              <h3 class="works-title">飲食店向け<br />ホームページ（デモ）</h3>
              <p class="works-desc">北区赤羽の架空コーヒーショップ「余白珈琲」のデモサイト。スライドショー・無限カルーセル・スクロールアニメーション実装。</p>
              <a href="https://intervention.jp/demo/cafe" class="works-link" target="_blank" rel="noopener noreferrer">見てみる →</a>
            </div>
          </div>
        </div>
        </div>
      </section>

      <!-- できること -->
      <section class="services reveal-section">
        <div class="section-inner">
          <h2 class="section-heading">
            <span class="section-label">選ばれる3つの理由</span>
          </h2>
          <div class="reason-list">
            {services.map((s) => (
              <div class="reason-item">
                <span class="reason-num" aria-hidden="true">{s.num}</span>
                <div class="reason-body">
                  <h3 class="reason-title">{s.name}</h3>
                  <p class="reason-desc">{s.desc}</p>
                </div>
              </div>
            ))}
          </div>
        </div>
      </section>

      <!-- インラインCTAバナー -->
      <section class="inline-cta reveal-section">
        <div class="section-inner">
          <div class="inline-cta-inner">
            <p class="inline-cta-heading">まず15分だけ話してみませんか？</p>
            <p class="inline-cta-sub">費用・契約・売り込みは一切なし。お店の状況を聞かせてもらうだけでかまいません。</p>
            <a href="https://lin.ee/PwGYxqQ" class="inline-cta-btn" target="_blank" rel="noopener noreferrer">
              <svg class="inline-cta-btn-icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" aria-hidden="true">
                <path d="M19.365 9.863c.349 0 .63.285.63.631 0 .345-.281.63-.63.63H17.61v1.125h1.755c.349 0 .63.283.63.63 0 .344-.281.629-.63.629h-2.386c-.345 0-.627-.285-.627-.629V8.108c0-.345.282-.63.627-.63h2.386c.349 0 .63.285.63.63 0 .349-.281.63-.63.63H17.61v1.125h1.755zm-3.855 3.016c0 .27-.174.51-.432.596-.064.021-.133.031-.199.031-.211 0-.391-.09-.51-.25l-2.443-3.317v2.94c0 .344-.279.629-.631.629-.346 0-.626-.285-.626-.629V8.108c0-.27.173-.51.43-.595.06-.023.136-.033.194-.033.195 0 .375.104.495.254l2.462 3.33V8.108c0-.345.282-.63.63-.63.345 0 .63.285.63.63v4.771zm-5.741 0c0 .344-.282.629-.631.629-.345 0-.627-.285-.627-.629V8.108c0-.345.282-.63.627-.63.349 0 .631.285.631.63v4.771zm-2.466.629H4.917c-.345 0-.63-.285-.63-.629V8.108c0-.345.285-.63.63-.63.348 0 .63.285.63.63v4.141h1.756c.348 0 .629.283.629.63 0 .344-.281.629-.629.629M24 10.314C24 4.943 18.615.572 12 .572S0 4.943 0 10.314c0 4.811 4.27 8.842 10.035 9.608.391.082.923.258 1.058.59.12.301.079.766.038 1.08l-.164 1.02c-.045.301-.24 1.186 1.049.645 1.291-.539 6.916-4.078 9.436-6.975C23.176 14.393 24 12.458 24 10.314"/>
              </svg>
              LINEで無料相談する →
            </a>
          </div>
        </div>
      </section>

      <!-- こんな流れで進みます -->
      <section class="flow reveal-section">
        <div class="section-inner">
          <h2 class="section-heading">
            <span class="section-label">こんな流れで進みます</span>
          </h2>
          <div class="timeline">
            <div class="timeline-item">
              <div class="timeline-dot"></div>
              <div class="timeline-num">01</div>
              <h3 class="timeline-title">手放したい作業を聞かせてください</h3>
              <p class="timeline-desc">LINEかメールで、今一番困ってることを教えてください。システムの話より先に、現状を聞くことから始めます。</p>
            </div>
            <div class="timeline-item">
              <div class="timeline-dot"></div>
              <div class="timeline-num">02</div>
              <h3 class="timeline-title">現状と理想を一緒に整理する</h3>
              <p class="timeline-desc">何が自動にできて何を一緒に考えるべきか。整理します。</p>
            </div>
            <div class="timeline-item">
              <div class="timeline-dot"></div>
              <div class="timeline-num">03</div>
              <h3 class="timeline-title">やること・費用をお伝えする</h3>
              <p class="timeline-desc">何をどう進めるか、いくらかかるかを明確にお伝えします。納得してからスタート。</p>
            </div>
            <div class="timeline-item">
              <div class="timeline-dot"></div>
              <div class="timeline-num">04</div>
              <h3 class="timeline-title">作って、動かして、更新し続ける</h3>
              <p class="timeline-desc">完成がゴールではありません。毎月一緒に見直しながら、育てていきます。</p>
            </div>
          </div>
        </div>
      </section>

      <!-- FAQ -->
      <section class="faq reveal-section">
        <div class="section-inner">
          <h2 class="section-heading">
            <span class="section-label">よくある質問</span>
          </h2>
          <dl class="faq-list">
            {faqs.map((item, i) => (
              <div class="faq-item" data-faq-index={i}>
                <dt class="faq-q">
                  <button
                    class="faq-btn"
                    aria-expanded="false"
                    aria-controls={`faq-answer-${i}`}
                    type="button"
                  >
                    <span class="faq-q-label">Q.</span>
                    <span class="faq-q-text">{item.q}</span>
                    <span class="faq-chevron" aria-hidden="true">
                      <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"/></svg>
                    </span>
                  </button>
                </dt>
                <dd class="faq-a" id={`faq-answer-${i}`} hidden>
                  <div class="faq-a-inner">
                    <span class="faq-a-label">A.</span>
                    <p class="faq-a-text">{item.a}</p>
                  </div>
                </dd>
              </div>
            ))}
          </dl>
        </div>
      </section>

      <!-- CTA -->
      <section id="contact" class="cta reveal-section">
        <div class="section-inner cta-inner">
          <h2 class="cta-heading">まず、手放したい作業を1つ教えてください。<br />そこから始めます。</h2>
          <p class="cta-sub">
            費用・契約・売り込みは一切なし。<br />「今一番困っていること」だけ聞かせてもらえれば十分です。
          </p>
          <div class="cta-buttons">
            <a
              href="https://lin.ee/PwGYxqQ"
              class="btn btn-line"
              target="_blank"
              rel="noopener noreferrer"
            >
              <svg class="btn-icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" aria-hidden="true">
